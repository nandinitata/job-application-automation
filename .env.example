# === Google AI / Gemini API ===
# Get your key at: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_api_key_here

# === Google Custom Search Engine ===
# Create at: https://programmablesearchengine.google.com/
GOOGLE_CSE_ID=your_custom_search_engine_id_here

# === Google Cloud (Vertex AI Search / Discovery Engine) ===
# Your GCP project ID — create at: https://console.cloud.google.com/
GCP_PROJECT_ID=your-gcp-project-id

# === Optional ===
# Set to 1 to preserve screenshots after verification (default: prune after 14 days)
PRESERVE_SCREENSHOTS=0
